DB_HOST=db
DB_NAME=forum
DB_USER=forum_app
DB_PASS=придумай_пароль
DB_ROOT_PASS=придумай_другой_пароль

# Адрес фронтенда, используется в ссылке из письма сброса пароля
# Mac: http://localhost:5173   Pi: https://forum.vov.md
APP_URL=http://localhost:5173
# true — в ответе 500 показывается текст ошибки (только для разработки; на Pi false)
APP_DEBUG=true

# Почта. По умолчанию — Mailpit (письма никуда не уходят, смотреть на http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=
MAIL_FROM=noreply@vov.md
MAIL_FROM_NAME=Forum
